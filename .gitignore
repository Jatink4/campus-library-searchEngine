# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
eggs/
*.egg-info/
pip-wheel-metadata/

# Installer logs
pip-log.txt

# Unit test / coverage reports
.pytest_cache/
.tox/
.coverage
coverage.xml
nosetests.xml
htmlcov/

# Virtual environments
env/
venv/
ENV/
.venv/
env.bak/
venv.bak/

# PyInstaller
